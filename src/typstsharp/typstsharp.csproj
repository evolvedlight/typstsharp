<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\PackageMetadata.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>typstsharp</PackageId>
    <Description>A .NET wrapper for the Typst typesetting system.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <NuspecFile>typstsharp.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildThisFileDirectory)</NuspecBasePath>
  </PropertyGroup>

  <Import Project="..\RustBuild.targets" />

  <PropertyGroup>
    <!-- Local builds only need the host runtime; native NuGet packages are built by src/typstsharp.runtime -->
    <RustTargets Condition="'$(RustTargets)' == ''">$(HostRustRuntime)</RustTargets>
  </PropertyGroup>

  <Target Name="BuildHostRust" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildRust" Condition="'$(SkipRustBuild)' != 'true'" />

  <Target Name="CopyNativeAssetsForLocalDev" AfterTargets="BuildHostRust" DependsOnTargets="BuildHostRust" Condition="'$(SkipRustBuild)' != 'true'">
    <ItemGroup>
      <HostRustRuntimeItem Include="@(RustRuntime)" Condition="'%(Identity)' == '$(HostRustRuntime)' and Exists('%(RustRuntime.CargoOutput)')" />
    </ItemGroup>

    <CreateItem Include="@(HostRustRuntimeItem->'%(CargoOutput)')" AdditionalMetadata="DestinationPath=$([System.IO.Path]::Combine('$(IntermediateOutputPath)', '%(PackagePathOnDisk)'))">
      <Output TaskParameter="Include" ItemName="HostNativeFile" />
    </CreateItem>

    <Copy SourceFiles="@(HostNativeFile)" DestinationFiles="@(HostNativeFile->'%(DestinationPath)')" SkipUnchangedFiles="true" Condition="@(HostNativeFile) != ''" />

    <ItemGroup Condition="@(HostNativeFile) != ''">
      <Content Include="@(HostNativeFile->'%(DestinationPath)')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
        <Visible>false</Visible>
        <Pack>false</Pack>
      </Content>
    </ItemGroup>

    <Copy SourceFiles="@(HostNativeFile->'%(DestinationPath)')" DestinationFiles="@(HostNativeFile->'$(OutDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="@(HostNativeFile) != ''" />
  </Target>

  <Target Name="SetTypstSharpNuspecProperties" BeforeTargets="_GetOutputItemsFromPack;GenerateNuspec">
    <PropertyGroup>
      <_NuspecTags>$([System.String]::Copy('$(PackageTags)').Replace(';', ' '))</_NuspecTags>
      <NuspecProperties>id=$(PackageId);version=$(PackageVersion);configuration=$(Configuration);authors=$(Authors);description=$(Description);tags=$(_NuspecTags);repositoryUrl=$(RepositoryUrl);license=$(PackageLicenseExpression)</NuspecProperties>
    </PropertyGroup>
  </Target>

</Project>
