<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>$id$</id>
    <version>$version$</version>
    <authors>$authors$</authors>
    <license type="expression">$license$</license>
    <readme>README.md</readme>
    <description>$description$</description>
    <tags>$tags$</tags>
    <repository type="git" url="$repositoryUrl$" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="typstsharp.runtime.win-x64" version="[$version$]" exclude="Build,Analyzers" />
        <dependency id="typstsharp.runtime.win-arm64" version="[$version$]" exclude="Build,Analyzers" />
        <dependency id="typstsharp.runtime.linux-x64" version="[$version$]" exclude="Build,Analyzers" />
        <dependency id="typstsharp.runtime.linux-arm64" version="[$version$]" exclude="Build,Analyzers" />
        <dependency id="typstsharp.runtime.osx-arm64" version="[$version$]" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net11.0">
        <dependency id="typstsharp.runtime.win-x64" version="[$version$]" exclude="Build,Analyzers" />
        <dependency id="typstsharp.runtime.win-arm64" version="[$version$]" exclude="Build,Analyzers" />
        <dependency id="typstsharp.runtime.linux-x64" version="[$version$]" exclude="Build,Analyzers" />
        <dependency id="typstsharp.runtime.linux-arm64" version="[$version$]" exclude="Build,Analyzers" />
        <dependency id="typstsharp.runtime.osx-arm64" version="[$version$]" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="../../README.md" target="" />
    <file src="bin/$configuration$/net10.0/typstsharp.dll" target="lib/net10.0/" />
    <file src="bin/$configuration$/net11.0/typstsharp.dll" target="lib/net11.0/" />
  </files>
</package>
